{
  "type": "json_schema",
  "json_schema": {
    "name": "credit_union_financial_schema",
    "schema": {
      "type": "object",
      "properties": {
        "documentType": {
          "type": "string",
          "description": "이 문서가 신용정보원 금융거래 조회 결과이면 credit_information_financial_result를 반환한다."
        },
        "sourceOrganization": {
          "type": "string",
          "description": "조회 결과 제공 기관명인 신용정보원를 반환한다."
        },
        "contactNumber": {
          "type": "string",
          "description": "문서 상단 또는 안내문에 표시된 대표 문의 전화번호. 확인할 수 없으면 빈 문자열."
        },
        "inquiryStatus": {
          "type": "string",
          "description": "조회 상태. complete, processing, no_records, not_found 중 문서 내용에 맞는 값을 반환한다."
        },
        "hasRecords": {
          "type": "boolean",
          "description": "피상속인의 자산·채무·계약 등 유효한 조회 결과가 하나 이상 있으면 true, 없으면 false."
        },
        "recordCount": {
          "type": "integer",
          "description": "records 배열의 항목 수."
        },
        "message": {
          "type": "string",
          "description": "조회 상태나 결과 존재 여부를 설명하는 핵심 안내 문구."
        },
        "warnings": {
          "type": "array",
          "description": "금액 기준일, 직접 문의 필요, 성명 불일치 등 결과 해석에 필요한 안내사항 목록. 없으면 빈 배열.",
          "items": {
            "type": "string"
          }
        },
        "requestNumber": {
          "type": "string",
          "description": "문서 상단의 접수번호."
        },
        "records": {
          "type": "array",
          "description": "신협별 예금·출자금 및 계좌별 대출거래 결과 목록.",
          "items": {
            "type": "object",
            "properties": {
              "authorizationNumber": {
                "type": "string",
                "description": "인가번호."
              },
              "institutionName": {
                "type": "string",
                "description": "신협명."
              },
              "phoneNumber": {
                "type": "string",
                "description": "신협 전화번호."
              },
              "postalCode": {
                "type": "string",
                "description": "우편번호."
              },
              "address": {
                "type": "string",
                "description": "상세주소."
              },
              "loanSequence": {
                "type": "integer",
                "description": "계좌별 대출거래 순번. 없으면 0."
              },
              "loanAmount": {
                "type": "integer",
                "description": "이자 미포함 대출금액을 원 단위 정수로 반환. 없으면 0."
              },
              "loanMaturityDate": {
                "type": "string",
                "description": "대출 만기일을 YYYY-MM-DD 형식으로 반환. 없으면 빈 문자열."
              },
              "depositAndShareAmount": {
                "type": "integer",
                "description": "이자 미포함 예금 및 출자금액을 원 단위 정수로 반환. 없으면 0."
              }
            },
            "required": [
              "authorizationNumber",
              "institutionName",
              "phoneNumber",
              "postalCode",
              "address",
              "loanSequence",
              "loanAmount",
              "loanMaturityDate",
              "depositAndShareAmount"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "documentType",
        "sourceOrganization",
        "contactNumber",
        "inquiryStatus",
        "hasRecords",
        "recordCount",
        "message",
        "warnings",
        "requestNumber",
        "records"
      ],
      "additionalProperties": false
    }
  }
}