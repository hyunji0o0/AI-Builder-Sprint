{
  "type": "json_schema",
  "json_schema": {
    "name": "community_credit_financial_schema",
    "schema": {
      "type": "object",
      "properties": {
        "documentType": {
          "type": "string",
          "description": "이 문서가 신용정보원 금융거래 조회 결과이면 credit_information_financial_result를 반환한다."
        },
        "sourceOrganization": {
          "type": "string",
          "description": "조회 결과 제공 기관명인 신용정보원를 반환한다."
        },
        "contactNumber": {
          "type": "string",
          "description": "문서 상단 또는 안내문에 표시된 대표 문의 전화번호. 확인할 수 없으면 빈 문자열."
        },
        "inquiryStatus": {
          "type": "string",
          "description": "조회 상태. complete, processing, no_records, not_found 중 문서 내용에 맞는 값을 반환한다."
        },
        "hasRecords": {
          "type": "boolean",
          "description": "피상속인의 자산·채무·계약 등 유효한 조회 결과가 하나 이상 있으면 true, 없으면 false."
        },
        "recordCount": {
          "type": "integer",
          "description": "records 배열의 항목 수."
        },
        "message": {
          "type": "string",
          "description": "조회 상태나 결과 존재 여부를 설명하는 핵심 안내 문구."
        },
        "warnings": {
          "type": "array",
          "description": "금액 기준일, 직접 문의 필요, 성명 불일치 등 결과 해석에 필요한 안내사항 목록. 없으면 빈 배열.",
          "items": {
            "type": "string"
          }
        },
        "requestNumber": {
          "type": "string",
          "description": "접수번호."
        },
        "deceasedName": {
          "type": "string",
          "description": "조회대상자 성명."
        },
        "residentRegistrationNumber": {
          "type": "string",
          "description": "조회대상자 주민등록번호. 문서에 마스킹된 형태 그대로 반환."
        },
        "inquiryDate": {
          "type": "string",
          "description": "조사기준일을 YYYY-MM-DD 형식으로 반환."
        },
        "requesterName": {
          "type": "string",
          "description": "의뢰인 성명."
        },
        "records": {
          "type": "array",
          "description": "새마을금고별 예금·대출·보험 관련 결과 목록.",
          "items": {
            "type": "object",
            "properties": {
              "institutionName": {
                "type": "string",
                "description": "금고명."
              },
              "hasDeposit": {
                "type": "boolean",
                "description": "예금관련 항목이 O 또는 보유로 표시되면 true, X·공란·해당없음이면 false."
              },
              "depositBalance": {
                "type": "integer",
                "description": "예금 총잔액을 원 단위 정수로 반환. 없으면 0."
              },
              "hasLoan": {
                "type": "boolean",
                "description": "대출관련 항목이 O 또는 보유로 표시되면 true, X·공란·해당없음이면 false."
              },
              "loanBalance": {
                "type": "integer",
                "description": "대출 관련 금액을 원 단위 정수로 반환. 없으면 0."
              },
              "hasInsurance": {
                "type": "boolean",
                "description": "보험관련 항목이 O 또는 보유로 표시되면 true, X·공란·해당없음이면 false."
              },
              "insuranceBalance": {
                "type": "integer",
                "description": "보험 관련 금액을 원 단위 정수로 반환. 없으면 0."
              },
              "phoneNumber": {
                "type": "string",
                "description": "금고 전화번호."
              },
              "address": {
                "type": "string",
                "description": "금고 주소."
              }
            },
            "required": [
              "institutionName",
              "hasDeposit",
              "depositBalance",
              "hasLoan",
              "loanBalance",
              "hasInsurance",
              "insuranceBalance",
              "phoneNumber",
              "address"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "documentType",
        "sourceOrganization",
        "contactNumber",
        "inquiryStatus",
        "hasRecords",
        "recordCount",
        "message",
        "warnings",
        "requestNumber",
        "deceasedName",
        "residentRegistrationNumber",
        "inquiryDate",
        "requesterName",
        "records"
      ],
      "additionalProperties": false
    }
  }
}