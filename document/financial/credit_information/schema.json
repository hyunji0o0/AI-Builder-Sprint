{
  "type": "json_schema",
  "json_schema": {
    "name": "credit_information_financial_schema",
    "schema": {
      "type": "object",
      "properties": {
        "documentType": {
          "type": "string",
          "description": "이 문서가 신용정보원 금융거래 조회 결과이면 credit_information_financial_result를 반환한다."
        },
        "sourceOrganization": {
          "type": "string",
          "description": "조회 결과 제공 기관명인 신용정보원를 반환한다."
        },
        "contactNumber": {
          "type": "string",
          "description": "문서 상단 또는 안내문에 표시된 대표 문의 전화번호. 확인할 수 없으면 빈 문자열."
        },
        "inquiryStatus": {
          "type": "string",
          "description": "조회 상태. complete, processing, no_records, not_found 중 문서 내용에 맞는 값을 반환한다."
        },
        "hasRecords": {
          "type": "boolean",
          "description": "피상속인의 자산·채무·계약 등 유효한 조회 결과가 하나 이상 있으면 true, 없으면 false."
        },
        "recordCount": {
          "type": "integer",
          "description": "records 배열의 항목 수."
        },
        "message": {
          "type": "string",
          "description": "조회 상태나 결과 존재 여부를 설명하는 핵심 안내 문구."
        },
        "warnings": {
          "type": "array",
          "description": "금액 기준일, 직접 문의 필요, 성명 불일치 등 결과 해석에 필요한 안내사항 목록. 없으면 빈 배열.",
          "items": {
            "type": "string"
          }
        },
        "records": {
          "type": "array",
          "description": "신용정보원 금융거래 조회 결과 행 목록.",
          "items": {
            "type": "object",
            "properties": {
              "institutionName": {
                "type": "string",
                "description": "금융기관명."
              },
              "transactionType": {
                "type": "string",
                "description": "금융거래종류."
              },
              "branchName": {
                "type": "string",
                "description": "담당점포명."
              },
              "amount": {
                "type": "integer",
                "description": "금액을 원 단위 정수로 반환. 없으면 0."
              },
              "repaymentDate": {
                "type": "string",
                "description": "상환일을 YYYY-MM-DD 형식으로 반환. 없으면 빈 문자열."
              },
              "representativeNumber": {
                "type": "string",
                "description": "금융기관 대표번호."
              },
              "isNameMismatch": {
                "type": "boolean",
                "description": "성명불일치가 표시되어 있으면 true, 아니면 false."
              }
            },
            "required": [
              "institutionName",
              "transactionType",
              "branchName",
              "amount",
              "repaymentDate",
              "representativeNumber",
              "isNameMismatch"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "documentType",
        "sourceOrganization",
        "contactNumber",
        "inquiryStatus",
        "hasRecords",
        "recordCount",
        "message",
        "warnings",
        "records"
      ],
      "additionalProperties": false
    }
  }
}