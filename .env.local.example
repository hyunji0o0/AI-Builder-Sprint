# 이 파일은 예시입니다. 실제 값은 절대 여기에 적지 말고 .env.local(gitignore됨)에 넣으세요.
# 아래 키들은 서버에서만 쓰이며, 특히 SERVICE_ROLE 키는 RLS를 우회하는 관리자 권한이라
# 저장소에 올라가면 DB 전체가 노출됩니다.

# Upstage 콘솔 > API Keys
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro3
UPSTAGE_SIMPLE_MODEL=solar-mini

# Python 자동 탐색이 실패할 때만 설정
# PYTHON_COMMAND=C:\path\to\python.exe

# Supabase 대시보드 > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Google 로그인용 브라우저 공개값입니다.
# service_role 키를 VITE_ 변수에 절대 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
