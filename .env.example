UPSTAGE_API_KEY=up_your_api_key_here
UPSTAGE_MODEL=solar-pro3
DOCUMENT_PIPELINE_MODE=python
# 선택 사항: 자동 탐색이 실패할 때만 지정
# PYTHON_COMMAND=C:\path\to\python.exe

# Google 로그인(Supabase Auth)에 필요. Supabase 대시보드 > Project Settings > API 에서 확인.
# Authentication > Providers > Google 이 켜져 있어야 실제 로그인이 동작함.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
